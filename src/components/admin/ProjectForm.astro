---
import type { Project } from '../../lib/data';

interface Props {
  project?: Project;
}

const { project } = Astro.props;
const method = project ? 'PUT' : 'POST';
const action = project ? `/api/projects/${project.id}` : '/api/projects';
const v = (s: string | null | undefined) => s ?? '';
---

<form id="project-form" data-method={method} data-action={action} class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Nombre</label>
      <input name="name" value={v(project?.name)} required class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none" />
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Slug (URL)</label>
      <input name="slug" value={v(project?.slug)} required pattern="[a-z0-9-]+" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none font-mono text-sm" />
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Fecha inicio</label>
      <input type="date" name="start_date" value={v(project?.start_date)} class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none" />
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Fecha fin (vacío = en curso)</label>
      <input type="date" name="end_date" value={v(project?.end_date)} class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none" />
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">URL</label>
      <input type="url" name="url" value={v(project?.url)} class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none" />
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Logo URL</label>
      <input name="logo_url" value={v(project?.logo_url)} class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none font-mono text-sm" />
    </div>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" name="is_active" checked={project?.is_active ?? true} class="w-4 h-4" />
    Activo
  </label>

  <div>
    <label class="block text-sm text-zinc-400 mb-1">Descripción corta (ES)</label>
    <textarea name="short_description_es" rows="2" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{v(project?.short_description_es)}</textarea>
  </div>
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Descripción corta (EN)</label>
    <textarea name="short_description_en" rows="2" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{v(project?.short_description_en)}</textarea>
  </div>
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Historia (ES)</label>
    <textarea name="history_es" rows="6" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{v(project?.history_es)}</textarea>
  </div>
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Historia (EN)</label>
    <textarea name="history_en" rows="6" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{v(project?.history_en)}</textarea>
  </div>

  <p id="form-error" class="text-red-500 text-sm hidden"></p>
  <button type="submit" class="bg-white text-black font-bold px-5 py-2.5 hover:bg-zinc-200 transition-colors">Guardar</button>
</form>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    const fd = new FormData(form);
    const str = (k: string) => {
      const val = String(fd.get(k) ?? '').trim();
      return val === '' ? null : val;
    };
    const payload = {
      name: String(fd.get('name') ?? '').trim(),
      slug: String(fd.get('slug') ?? '').trim(),
      is_active: fd.get('is_active') === 'on',
      start_date: str('start_date'),
      end_date: str('end_date'),
      url: str('url'),
      logo_url: str('logo_url'),
      short_description_es: str('short_description_es'),
      short_description_en: str('short_description_en'),
      history_es: str('history_es'),
      history_en: str('history_en'),
    };
    const res = await fetch(form.dataset.action!, {
      method: form.dataset.method!,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      location.href = '/admin';
    } else {
      const data = await res.json().catch(() => ({}));
      errorEl.textContent = data.error || 'Error al guardar';
      errorEl.classList.remove('hidden');
    }
  });
</script>
