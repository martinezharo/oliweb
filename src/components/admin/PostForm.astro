---
import type { Post } from '../../lib/data';

interface Props {
  post?: Post;
}

const { post } = Astro.props;
const method = post ? 'PUT' : 'POST';
const action = post ? `/api/posts/${post.id}` : '/api/posts';
const imageUrls = (post?.image_urls ?? []).join('\n');
---

<form id="post-form" data-method={method} data-action={action} class="space-y-6">
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Contenido (ES)</label>
    <textarea name="content_es" rows="5" required class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{post?.content_es ?? ''}</textarea>
  </div>
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Contenido (EN)</label>
    <textarea name="content_en" rows="5" required class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none">{post?.content_en ?? ''}</textarea>
  </div>
  <div>
    <label class="block text-sm text-zinc-400 mb-1">Imágenes (una URL por línea)</label>
    <textarea name="image_urls" rows="3" class="w-full bg-zinc-900 border border-zinc-800 px-3 py-2 focus:border-zinc-500 outline-none font-mono text-sm">{imageUrls}</textarea>
  </div>
  <p id="form-error" class="text-red-500 text-sm hidden"></p>
  <button type="submit" class="bg-white text-black font-bold px-5 py-2.5 hover:bg-zinc-200 transition-colors">Guardar</button>
</form>

<script>
  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    const fd = new FormData(form);
    const payload = {
      content_es: String(fd.get('content_es') ?? ''),
      content_en: String(fd.get('content_en') ?? ''),
      image_urls: String(fd.get('image_urls') ?? '')
        .split('\n')
        .map((s) => s.trim())
        .filter(Boolean),
    };
    const res = await fetch(form.dataset.action!, {
      method: form.dataset.method!,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      location.href = '/admin';
    } else {
      const data = await res.json().catch(() => ({}));
      errorEl.textContent = data.error || 'Error al guardar';
      errorEl.classList.remove('hidden');
    }
  });
</script>
